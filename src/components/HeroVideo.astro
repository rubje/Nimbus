---
/**
 * Full-screen hero with a muted looping background video.
 * Files: /public/video/hero.mp4 (+ optional hero.webm) and /public/video/hero-poster.jpg
 * (+ optional hero-poster-960.webp and hero-poster-1920.webp for faster loading).
 * If hero.mp4 doesn't exist yet, only the poster image is shown.
 * The video is not loaded for visitors who prefer reduced motion or use data saver.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  kicker: string;
  title: string;
  lead: string;
}

const { kicker, title, lead } = Astro.props;
const publicDir = path.join(process.cwd(), 'public');
const has = (f: string) => fs.existsSync(path.join(publicDir, f));
const hasMp4 = has('video/hero.mp4');
const hasWebm = has('video/hero.webm');
const poster = '/video/hero-poster.jpg';
const hasPosterWebp = has('video/hero-poster-960.webp') && has('video/hero-poster-1920.webp');
---

<section class="hero">
  <div class="hero__media">
    <picture>
      {hasPosterWebp && <source type="image/webp" srcset="/video/hero-poster-960.webp 960w, /video/hero-poster-1920.webp 1920w" sizes="100vw" />}
      <img class="hero__poster" src={poster} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
    </picture>
    {
      hasMp4 && (
        <video class="hero__video" muted loop playsinline preload="none" poster={poster} aria-hidden="true" data-hero-video>
          {hasWebm && <source data-src="/video/hero.webm" type="video/webm" />}
          <source data-src="/video/hero.mp4" type="video/mp4" />
        </video>
      )
    }
    <div class="hero__shade"></div>
  </div>
  <div class="container hero__content">
    <span class="kicker">{kicker}</span>
    <h1 class="hero__title">{title}</h1>
    <p class="hero__lead">{lead}</p>
    <div class="hero__actions"><slot /></div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; isolation: isolate; overflow: hidden; }
  .hero__media, .hero__poster, .hero__video, .hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__media { z-index: -1; }
  .hero__poster, .hero__video { object-fit: cover; }
  .hero__video { opacity: 0; transition: opacity 1.2s var(--ease); }
  .hero__video.is-playing { opacity: 1; }
  .hero__shade { background: linear-gradient(180deg, rgb(7 43 53 / 0.35) 0%, rgb(7 43 53 / 0.15) 40%, rgb(11 60 73 / 0.92) 100%); }
  .hero__content { padding-block: 8rem var(--space-l); }
  .hero__title { font-size: var(--step-4); max-width: 14ch; margin-bottom: 0.4em; }
  .hero__lead { font-size: var(--step-1); font-weight: 300; max-width: 40ch; color: var(--offwhite); }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }
</style>

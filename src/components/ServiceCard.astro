---
import type { Service } from '../data/services';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  service: Service;
  lang: Lang;
  /** Show inclusions and "ideal for" (Services page). */
  detailed?: boolean;
  index: number;
  /** Heading level of the title; inner labels use the next level. */
  headingLevel?: 'h2' | 'h3';
}

const { service, lang, detailed = false, index, headingLevel = 'h3' } = Astro.props;
const Title = headingLevel;
const Label = headingLevel === 'h2' ? 'h3' : 'h4';
const t = useTranslations(lang);
const soon = service.status === 'soon';
---

<article class:list={['service', { 'service--soon': soon, 'service--detailed': detailed }]} id={service.id} data-reveal>
  <div class="service__head">
    <span class="service__num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    {soon && <span class="service__badge">{t.services.soon}</span>}
  </div>
  <Title class="service__title">{service.title[lang]}</Title>
  <p class="service__summary">{service.summary[lang]}</p>
  {
    detailed && (
      <div class="service__details">
        <div>
          <Label class="service__label">{t.services.included}</Label>
          <ul class="service__list">
            {service.included.map((i) => <li>{i[lang]}</li>)}
          </ul>
        </div>
        <div>
          <Label class="service__label">{t.services.idealFor}</Label>
          <p>{service.idealFor[lang]}</p>
        </div>
      </div>
    )
  }
</article>

<style>
  .service {
    position: relative; overflow: hidden; isolation: isolate; height: 100%;
    padding: var(--space-m); border-radius: var(--radius); border: 1px solid rgb(255 255 255 / 0.07);
    background: linear-gradient(160deg, rgb(18 80 95 / 0.85) 0%, rgb(8 36 44 / 0.9) 45%, rgb(3 8 9 / 0.95) 100%);
    box-shadow: var(--shadow-card);
    transition: border-color 0.5s, transform 0.6s var(--ease);
  }
  /* Orange glow that blooms on hover. */
  .service::before {
    content: ''; position: absolute; z-index: -1; width: 380px; height: 380px; right: -140px; top: -180px;
    background: radial-gradient(circle, rgb(255 106 26 / 0.18), transparent 65%); opacity: 0.5; transition: opacity 0.6s;
  }
  .service:hover { border-color: rgb(255 106 26 / 0.3); transform: translateY(-3px); }
  .service:hover::before { opacity: 1; }
  .service--soon { background: linear-gradient(160deg, rgb(8 36 44 / 0.6), rgb(3 8 9 / 0.8)); border-style: dashed; border-color: rgb(255 255 255 / 0.15); }
  .service__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .service__num { font-size: var(--step--1); color: var(--orange-text); font-weight: 600; letter-spacing: 0.1em; }
  .service__badge { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; border: 1px solid var(--orange); color: var(--orange-text); padding: 0.2rem 0.7rem; border-radius: 999px; }
  .service__summary { color: var(--muted); }
  .service--detailed .service__title { font-size: var(--step-2); }
  .service__details { display: grid; gap: var(--space-m); margin-top: var(--space-m); padding-top: var(--space-m); border-top: 1px solid var(--line); }
  @media (min-width: 760px) { .service__details { grid-template-columns: 3fr 2fr; } }
  .service__title { font-size: var(--step-1); }
  .service__label { font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); font-weight: 600; margin: 0 0 1rem; }
  .service__list { display: grid; gap: 0.6rem; }
  .service__list li { padding-left: 1.6rem; position: relative; }
  .service__list li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 0.8rem; height: 2px; background: var(--orange); }
</style>

---
import { site } from '../config/site';
import { routes, langs, locales, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  image?: string;
}

const { lang, route, title, description, image = site.ogImage } = Astro.props;
const canonical = site.url + routes[route][lang];
const imageUrl = new URL(image, site.url).href;
const others = langs.filter((l) => l !== lang);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{langs.map((l) => <link rel="alternate" hreflang={l} href={site.url + routes[route][l]} />)}
<link rel="alternate" hreflang="x-default" href={site.url + routes[route].nl} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.legalName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locales[lang]} />
{others.map((l) => <meta property="og:locale:alternate" content={locales[l]} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VideoModal from '../components/VideoModal.astro';
import { site } from '../config/site';
import { useTranslations, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  ogImage?: string;
  /** Transparent header over a full-bleed hero. */
  overlayHeader?: boolean;
  noindex?: boolean;
}

const { lang, route, title, description, ogImage, overlayHeader = false, noindex = false } = Astro.props;
const t = useTranslations(lang);
const fullTitle = route === 'home' ? `${site.brand}: ${title}` : `${title} | ${site.brand}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href="/fonts/Sora-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0B3C49" />
    <SEO lang={lang} route={route} title={fullTitle} description={description} image={ogImage} />
    <JsonLd lang={lang} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
    {
      site.cfAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} route={route} overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <VideoModal lang={lang} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { useTranslations, path, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} route="privacy" title={t.meta.privacy.title} description={t.meta.privacy.description}>
  <section class="container page-head">
    <h1>{t.privacy.title}</h1>
    <p class="updated">{t.privacy.updated}</p>
  </section>
  <section class="container section prose section--flush">
    {
      t.privacy.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          <p>{s.p}</p>
        </>
      ))
    }
    <p>
      {site.legalName}, {site.city}<br />
      {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <a href={path('contact', lang)}>{t.privacy.contactLink}</a>}
    </p>
  </section>
</Base>

<style>
  .updated { color: var(--muted); }
  .prose { max-width: 720px; }
  .prose h2 { font-size: var(--step-1); margin-top: 2.5rem; }
  .prose p { color: var(--muted); }
</style>

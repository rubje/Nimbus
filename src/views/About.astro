---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import { equipment } from '../data/equipment';
import { site } from '../config/site';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} route="about" title={t.meta.about.title} description={t.meta.about.description}>
  <section class="container page-head">
    <span class="kicker">{site.brand}</span>
    <h1>{t.about.title}</h1>
  </section>

  <section class="container section about" style="padding-top: 0">
    <div class="about__bio" data-reveal>
      {t.about.bio.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
    </div>
    <aside class="about__cert" data-reveal aria-labelledby="cert-title">
      <svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true">
        <path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Zm-1.2 14.2L7 12.4l1.4-1.4 2.4 2.4 4.8-4.8L17 10l-6.2 6.2Z" fill="var(--orange)" />
      </svg>
      <h2 id="cert-title">{t.about.certTitle}</h2>
      <p>{t.about.certText}</p>
      {site.operatorId && <p class="about__op"><strong>{t.about.operatorLabel}:</strong> {site.operatorId}</p>}
    </aside>
  </section>

  <section class="section section--deep">
    <div class="container about__cols">
      <div data-reveal>
        <h2>{t.about.gearTitle}</h2>
        <ul class="gear">
          {equipment.map((g) => <li><strong>{g.name}</strong><span>{g.note[lang]}</span></li>)}
        </ul>
      </div>
      <div data-reveal>
        <h2>{t.about.approachTitle}</h2>
        <ul class="approach">
          {t.about.approach.map((a) => <li>{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <CTA lang={lang} />
</Base>

<style>
  .about { display: grid; gap: var(--space-m); }
  @media (min-width: 900px) { .about { grid-template-columns: 1.5fr 1fr; align-items: start; } }
  .about__bio .lead { color: var(--offwhite); }
  .about__bio p:not(.lead) { color: var(--muted); }
  .about__cert { background: var(--petrol-light); border-radius: var(--radius); padding: var(--space-m); border: 1px solid var(--line); }
  .about__cert h2 { font-size: var(--step-2); margin-top: 1rem; }
  .about__cert p { color: var(--muted); }
  .about__op { color: var(--offwhite) !important; }
  .about__cols { display: grid; gap: var(--space-l); }
  @media (min-width: 900px) { .about__cols { grid-template-columns: 1fr 1fr; } }
  .about__cols h2 { font-size: var(--step-2); }
  .gear li { display: grid; gap: 0.2rem; padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .gear span { color: var(--muted); font-size: 0.95rem; }
  .approach { display: grid; gap: 1rem; }
  .approach li { padding-left: 1.6rem; position: relative; color: var(--muted); }
  .approach li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 0.8rem; height: 2px; background: var(--orange); }
</style>
